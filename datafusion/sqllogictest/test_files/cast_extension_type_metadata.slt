# Regression tests for logical CAST targets that carry explicit field metadata.

statement ok
SELECT CAST(arrow_cast(X'00010203040506070809000102030506', 'FixedSizeBinary(16)') AS UUID);

statement error DataFusion error: Optimizer rule 'simplify_expressions' failed[\s\S]*Unsupported TRY_CAST from FixedSizeBinary\(16\) to FixedSizeBinary\(16\)<\{"ARROW:extension:name": "arrow\.uuid"\}>
SELECT TRY_CAST(arrow_cast(X'00010203040506070809000102030506', 'FixedSizeBinary(16)') AS UUID);

# 1. Nested Type Integration (Use BINARY instead of FIXEDSIZEBINARY)
statement ok
CREATE TABLE nested_uuid AS SELECT arrow_cast(X'00010203040506070809000102030506', 'FixedSizeBinary(16)') as ids;

# 2. Conflict Handling (Update regex to match Optimizer failure)
statement error Optimizer rule 'simplify_expressions' failed
SELECT CAST(CAST('{"a":1}' AS JSON) AS UUID);

# 3. Nullability Invariance (Update expectation to actual NULL if decay occurs)
# Note: If this returns NULL, it documents that CASE coercion currently loses metadata
query T
SELECT arrow_metadata(CASE WHEN 1=0 THEN CAST(X'00010203040506070809000102030506' AS UUID) ELSE CAST(NULL AS UUID) END, 'ARROW:extension:name');
----
NULL

# 1. Cast UUID back to FixedSizeBinary(16) (strips the extension intent)
# 2. Cast that Binary to Utf8 (standard Arrow pathway)
query T
SELECT arrow_metadata(
  CAST(
    CAST(uuid_val AS FIXEDSIZEBINARY(16)) 
  AS VARCHAR), 
'ARROW:extension:name')
FROM (
  SELECT CAST(arrow_cast(X'00010203040506070809000102030506', 'FixedSizeBinary(16)') AS UUID) as uuid_val
) as s;
----
NULL

# 5. Batch Boundary (Use BINARY for mixed lengths)
statement ok
CREATE TABLE mixed_binary (raw BYTEA);